# settings for run_test.sh, the tests read them through lib/constants.py
BASE_URL=http://localhost:50000
HEADLESS=1           # 0 = show the browser window
CHROME_BIN="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# CHROMEDRIVER_BIN=tools/chromedriver   written by ./tools/install_chromedriver.sh
UI_TIMEOUT=15        # seconds a normal wait accepts
# SAUCEDEMO_CLONE_DIR=../saucedemo_clone   # only used when BASE_URL answers nothing, then the tests start the clone themselves and stop it again after the run
